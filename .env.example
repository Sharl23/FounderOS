# Optional overrides. Copy to .env . No API keys exist anywhere in this project.
# Default: Apache-2.0 open-weight model, ~986 MB download, fits CPU-only laptops.
OLLAMA_MODEL=qwen2.5:1.5b-instruct
# Stronger hardware only (several GB RAM more). Benchmark before relying on it; it does not change any gate.
# OLLAMA_MODEL=qwen2.5:7b-instruct
# Seconds to wait for one local model answer before failing honestly (no mock fallback).
OLLAMA_TIMEOUT_S=150
