# Optional overrides. Copy to .env next to docker-compose.yml. No paid API keys exist anywhere in this project.
# Default model: Apache-2.0 open weights, ~986 MB download, runs on CPU-only laptops.
OLLAMA_MODEL=qwen2.5:1.5b-instruct
# Where the app finds Ollama. Default: Ollama running on the host machine.
# For the optional container (docker compose --profile ollama up) use http://ollama:11434
OLLAMA_URL=http://host.docker.internal:11434
# Seconds to wait for one local model answer before failing honestly (no mock fallback).
OLLAMA_TIMEOUT_S=150
# Memory controls, sent with every request:
#   OLLAMA_NUM_GPU=0   -> force CPU (use after "cudaMalloc failed: out of memory")
#   OLLAMA_NUM_CTX=1024 -> smaller context window, less RAM (use after "failed to allocate CPU_REPACK buffer")
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_GPU=
OLLAMA_NUM_THREAD=
# A smaller model is only ever YOUR explicit choice; FounderOS never switches models by itself.
# It was NOT benchmarked by the authors:  OLLAMA_MODEL=qwen2.5:0.5b-instruct
# Optional OpenAlex polite-pool contact / free key (research works without them):
OPENALEX_MAILTO=
OPENALEX_API_KEY=
# Path of the SQLite database inside the container (the founder_data volume).
FOUNDEROS_DB=/data/founderos-v2.sqlite3
# There is NO payment provider key setting: payments are MOCKED / TEST MODE only and live mode does not exist in the code.
